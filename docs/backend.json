
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Informations de profil de l'utilisateur CTM Hub",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Employee", "Manager", "HR", "Owner", "Dev"] },
        "department": { "type": "string" },
        "dob": { "type": "string" },
        "phone": { "type": "string" },
        "officeDaysPerWeek": { "type": "number" },
        "avatarUrl": { "type": "string" },
        "onboardingCompleted": { "type": "boolean" }
      },
      "required": ["id", "email", "name", "role", "onboardingCompleted"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Profils des employés et administrateurs"
    }
  }
}
